{
  "name": "online-lecture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests '*.config.ts' '*.config.mjs' --no-error-on-unmatched-pattern --no-config-lookup --ext .ts,.tsx,.mjs --parser @typescript-eslint/parser --global process --rule 'no-undef:error'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "env -u NO_COLOR NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 NEXT_PUBLIC_SUPABASE_ANON_KEY=e2e-public-anon-key NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000 SUPABASE_SERVICE_ROLE_KEY=never-expose-e2e-service-role playwright test --pass-with-no-tests"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.95.3",
    "@tailwindcss/postcss": "4.1.18",
    "next": "16.2.12",
    "postcss": "8.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.1.18"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
